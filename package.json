  "dependencies": {
    "@aws-sdk/client-s3": "^3.955.0",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "heic-convert": "^2.1.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "node-cache": "^5.1.2",
    "nodemon": "^3.1.11",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.0",
    "jest": "^30.3.0",
    "supertest": "^6.3.4"
  }
}
