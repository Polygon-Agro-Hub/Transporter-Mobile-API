{
  "name": "transporter-mobile-api",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "test": "jest",
    "test:auth": "jest tests/endpoint/userAuth-ep.test.js --forceExit",
    "test:complain": "jest tests/endpoint/complain-ep.test.js --forceExit",
    "test:order": "jest tests/endpoint/order-ep.test.js --forceExit",
    "test:return": "jest tests/endpoint/return-ep.test.js --forceExit",
    "test:hold": "jest tests/endpoint/hold-ep.test.js --forceExit",
    "test:home": "jest tests/endpoint/home-ep.test.js --forceExit",
    "test:unit": "jest tests/endpoint/ --forceExit",
    "test:performance": "jest --testPathPatterns=performance --verbose --runInBand",
    "test:performance:detailed": "jest --testPathPatterns=performance --verbose --runInBand --detectOpenHandles",
    "test:performance:watch": "jest --testPathPatterns=performance --watch",
    "start": "node api/index.js",
    "dev": "nodemon server.js",
    "seed": "node seed/mainseed.js"
  },
  "keywords": [],
